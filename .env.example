# Copy this file to .env.local and fill in your values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
ADMIN_PASSWORD=choose_a_strong_password

# football-data.org (PRIMARY — 10 req/min, no daily cap)
FOOTBALL_DATA_API_KEY=<optional football-data.org key>

# API-Football (api-football.com — FALLBACK — 100 req/day cap)
API_FOOTBALL_KEY=your_api_football_key_here

NEXT_PUBLIC_DAILY_CODE_PREFIX=REPLACEWITHSOMETHING

